{
  "name": "@moneyonchain/periphery",
  "version": "3.0.4",
  "description": "Reusable Money on Chain utility, interface, and governance contracts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/money-on-chain/MoC-Periphery.git"
  },
  "bugs": {
    "url": "https://github.com/money-on-chain/MoC-Periphery/issues"
  },
  "homepage": "https://github.com/money-on-chain/MoC-Periphery#readme",
  "license": "UNLICENSED",
  "files": [
    "contracts",
    "dist"
  ],
  "scripts": {
    "clean": "hardhat clean && rm -rf dist artifacts cache",
    "compile": "hardhat compile",
    "build": "pnpm clean && pnpm compile",
    "format": "prettier --write \"contracts/**/*.sol\"",
    "format:check": "prettier --check \"contracts/**/*.sol\"",
    "lint:sol": "solhint \"contracts/**/*.sol\"",
    "lint:sol:fix": "solhint --fix \"contracts/**/*.sol\"",
    "lint": "pnpm lint:sol && pnpm format:check",
    "test": "pnpm build",
    "prepare": "husky"
  },
  "dependencies": {
    "@openzeppelin/contracts-ethereum-package": "3.0.0",
    "solc": "0.8.35"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-viem": "5.0.7",
    "hardhat": "3.9.0",
    "husky": "^9.1.7",
    "prettier": "2.8.8",
    "prettier-plugin-solidity": "^1.4.3",
    "solhint": "^6.0.1"
  },
  "exports": {
    "./contracts/*": "./contracts/*",
    "./package.json": "./package.json"
  },
  "type": "module",
  "packageManager": "pnpm@10.13.1+sha512.37ebf1a5c7a30d5fabe0c5df44ee8da4c965ca0c5af3dbab28c3a1681b70a256218d05c81c9c0dcf767ef6b8551eb5b960042b9ed4300c59242336377e01cfad"
}
